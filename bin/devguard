#!/usr/bin/env bash
# devguard: one command for everything (interactive menu + direct CLI subcommands).
set -eu

SELF=$0
while [ -L "$SELF" ]; do
  t=$(readlink "$SELF")
  case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac
done
KIT_DIR=$(cd "$(dirname "$SELF")/.." && pwd -P)

usage() {
  cat <<EOF
devguard — evidence-first working mode and token-saving tools for AI coding agents
Kit: $KIT_DIR

  devguard                      interactive menu (when run in a terminal)
  devguard status               compact overview of what is installed, wired and set up
  devguard doctor [--fix]       audit installation health & conflicts (--fix: repair automatically)
  devguard stats [options]      token savings, codegraph index & verification pass-rate stats
                                (-d daily, -p current project, --dashboard, --reset)
  devguard select               interactively pick agents and tools to enable/disable
  devguard update               pull the latest kit, upgrade tools, and re-apply settings
  devguard init [--all]         set up this repo, or every repo under auto-setup folders
  devguard install [options]    install or change setup (see: devguard install --help)
  devguard uninstall [--purge]  remove wiring (--purge: also remove installed tool CLIs)
  devguard disable              interactive alias for uninstall / unwire
  devguard skip                 never set up this repository automatically
  devguard docs                 show where the guides are
EOF
}

# Interactive multi-select for agents and components
run_select() {
  # shellcheck source=bin/ui.sh
  . "$KIT_DIR/bin/ui.sh"
  # shellcheck source=lib.sh
  . "$KIT_DIR/lib.sh"
  # shellcheck source=components/common.sh
  . "$KIT_DIR/components/common.sh"
  load_components

  local cur_components="" c
  for c in $ALL_COMPONENTS; do
    if [ -n "$(state_wired "$c")" ]; then
      [ -n "$cur_components" ] && cur_components="$cur_components,$c" || cur_components="$c"
    fi
  done
  [ -n "$cur_components" ] || cur_components=$DEFAULT_COMPONENTS

  local default_agents="claude,vscode,antigravity"
  [ -d "$HOME/.config/opencode" ] && default_agents="$default_agents,opencode"
  [ -d "$HOME/.cursor" ] && default_agents="$default_agents,cursor"
  [ -d "$HOME/.codex" ] && default_agents="$default_agents,codex"
  is_ours "$GEMINI_SKILLS/$SKILL_NAME" && default_agents="$default_agents,gemini"

  UI_RESULT=""
  ui_multiselect "Select agents to configure" \
    "claude:Claude Code,vscode:VS Code (Copilot),antigravity:Google Antigravity,opencode:OpenCode,cursor:Cursor IDE,codex:Codex CLI,gemini:Gemini CLI" \
    "$default_agents" || return 0
  local chosen_agents=$UI_RESULT
  [ -n "$chosen_agents" ] || { echo "No agents selected."; return 0; }

  ui_multiselect "Select tools (components) to enable" \
    "codegraph:CodeGraph (AST code index & call graph),projectmem:ProjectMem (per-project issue & fix memory),rtk:RTK (90%+ shell output compression),context-mode:Context-Mode (sandboxed execution & search)" \
    "$cur_components" || return 0
  local chosen_tools=$UI_RESULT
  [ -n "$chosen_tools" ] || chosen_tools="none"

  # Unwire any component that was previously wired but is no longer selected
  for c in $ALL_COMPONENTS; do
    if [ -n "$(state_wired "$c")" ]; then
      case ",$chosen_tools," in
        *,"$c",*) ;;
        *) component_down "$c" 0 ;;
      esac
    fi
  done

  "$KIT_DIR/install.sh" --targets="$chosen_agents" --with="$chosen_tools"
}

run_interactive_uninstall() {
  # shellcheck source=bin/ui.sh
  . "$KIT_DIR/bin/ui.sh"
  UI_CHOICE=0
  ui_choose "Uninstall / Disable devguard" \
    "Unwire only — ถอดการเชื่อมต่อจากทุก Agent (เก็บ CLI ของเครื่องมือไว้)" \
    "Full Uninstall (--purge) — ถอดทั้งหมดและลบ CLI ที่ devguard ติดตั้งด้วย" \
    "Dry Run — ดูสิ่งที่จะถูกลบโดยไม่ลบจริง" \
    "Cancel — ยกเลิก" || return 0
  case "$UI_CHOICE" in
    0) "$KIT_DIR/uninstall.sh" ;;
    1) "$KIT_DIR/uninstall.sh" --purge ;;
    2) "$KIT_DIR/uninstall.sh" --dry-run ;;
    *) echo "Cancelled." ;;
  esac
}

run_menu() {
  # shellcheck source=bin/ui.sh
  . "$KIT_DIR/bin/ui.sh"
  "$KIT_DIR/status.sh"
  UI_CHOICE=0
  ui_choose "Select an action" \
    "Select & Install   — เลือกเปิด/ปิด Agents และเครื่องมือ (CodeGraph, ProjectMem, RTK)" \
    "Doctor & Repair    — ตรวจสอบสุขภาพการติดตั้งและซ่อมจุดที่มีปัญหาอัตโนมัติ (--fix)" \
    "Stats & ROI        — ดูสถิติการประหยัด Token และอัตราการ Verify ผ่าน" \
    "Reset RTK Stats    — รีเซ็ตตัวนับสถิติของ RTK เพื่อเริ่มนับใหม่" \
    "Update             — อัปเดต devguard และเครื่องมือเป็นเวอร์ชันล่าสุด" \
    "Init All Projects  — ตั้งค่าทุกโปรเจกต์ใน ~/Developer ทันที" \
    "Disable/Uninstall  — ถอดการเชื่อมต่อ หรือถอนการติดตั้ง" \
    "Quit               — ออก" || return 0
  case "$UI_CHOICE" in
    0) run_select ;;
    1) "$KIT_DIR/bin/doctor.sh" --fix ;;
    2) "$KIT_DIR/bin/stats.sh" ;;
    3) "$KIT_DIR/bin/stats.sh" --reset ;;
    4) "$0" update ;;
    5) "$0" init --all ;;
    6) run_interactive_uninstall ;;
    *) ;;
  esac
}

if [ $# -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ]; then
    run_menu
    exit 0
  else
    usage
    exit 0
  fi
fi

cmd=$1
shift

case "$cmd" in
  menu) run_menu ;;
  status | info) exec "$KIT_DIR/status.sh" "$@" ;;
  doctor) exec "$KIT_DIR/bin/doctor.sh" "$@" ;;
  stats) exec "$KIT_DIR/bin/stats.sh" "$@" ;;
  select) run_select ;;
  install)
    if [ "${1:-}" = "-i" ] || [ "${1:-}" = "--interactive" ]; then
      run_select
    else
      exec "$KIT_DIR/install.sh" "$@"
    fi
    ;;
  uninstall | disable)
    if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ] && [ "$cmd" = "disable" ]; then
      run_interactive_uninstall
    else
      exec "$KIT_DIR/uninstall.sh" "$@"
    fi
    ;;
  update)
    git -C "$KIT_DIR" pull --ff-only 2>/dev/null || true
    # shellcheck source=lib.sh
    . "$KIT_DIR/lib.sh"
    # shellcheck source=components/common.sh
    . "$KIT_DIR/components/common.sh"
    load_components
    for c in $ALL_COMPONENTS; do
      [ -n "$(state_wired "$c")" ] && component_upgrade "$c"
    done
    if command -v brew >/dev/null 2>&1; then
      if [ -f "$HOME/.agent-kit/components/rtk/installed-by-kit" ]; then
        brew upgrade rtk 2>/dev/null || true
      fi
      command -v xcbeautify >/dev/null 2>&1 && { brew upgrade xcbeautify 2>/dev/null || true; } || { brew install xcbeautify 2>/dev/null || true; }
      command -v ast-grep >/dev/null 2>&1 && { brew upgrade ast-grep 2>/dev/null || true; } || { brew install ast-grep 2>/dev/null || true; }
    fi
    "$KIT_DIR/install.sh" "$@"
    echo
    exec "$KIT_DIR/status.sh"
    ;;
  init)
    if [ "${1:-}" = --all ]; then
      roots="$HOME/.agent-kit/auto-roots"
      [ -f "$roots" ] || { echo "No auto-setup folders. Use: devguard init-all <dir>, or install with --auto-project=<dir>" >&2; exit 1; }
      while IFS= read -r root; do
        [ -d "$root" ] && "$KIT_DIR/bin/project.sh" init-all "$root" < /dev/null
      done < "$roots"
    else
      exec "$KIT_DIR/bin/project.sh" init "$@"
    fi
    ;;
  init-all) exec "$KIT_DIR/bin/project.sh" init-all "$@" ;;
  skip)
    top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "not inside a git repository" >&2; exit 1; }
    : > "$top/.agent-kit-skip"
    echo "Created $top/.agent-kit-skip — this repository will not be set up automatically."
    ;;
  docs)
    echo "English:  $KIT_DIR/README.md"
    echo "ภาษาไทย:  $KIT_DIR/docs/USAGE.th.md"
    echo "Radar:    $KIT_DIR/docs/UPSTREAM-RADAR.md"
    ;;
  help | -h | --help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 64 ;;
esac
